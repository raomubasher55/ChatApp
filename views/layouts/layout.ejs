<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title || 'Dashboard' %>
  </title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.js"></script>
  <script src="https://cdn.socket.io/3.1.3/socket.io.min.js"
    integrity="sha384-cPwlPLvBTa3sKAgddT6krw0cJat7egBga3DJepJyrLl4Q9/5WLra3rrnMcyTyOnh"
    crossorigin="anonymous"></script>

</head>

<body class="flex">
  <!-- Include the Sidebar -->
  <%- include('../partials/sidebar') %>

    <!-- Main Content -->
    <main class="p-6 flex-1">
      <%- include(content) %>
    </main>
    <script>
      function getCookie(name) {
        let matches = document.cookie.match(new RegExp(
          "(?:^|; )" + name.replace(/([\.$?*|{}\(\)\[\]\\\/\+^])/g, '\\$1') + "=([^;]*)"
        ));
        return matches ? decodeURIComponent(matches[1]) : undefined;
      }

      const user =JSON.parse(getCookie('user'));
  
      const deleteButton = document.createElement('button');

      // document.addEventListener('DOMContentLoaded', () => {
      let receiverId, senderId = user._id;
      const socket = io('/user-namespace', {
        auth: {
          token: user._id
        }
      });

      // Listen for updates to user online/offline status
      socket.on('getOnlineUser', (data) => {
        const statusElement = document.getElementById(`status-${data.userId}`);
        const onlineStatusElement = document.getElementById(`onlineStatus-${data.userId}`);
        if (statusElement && onlineStatusElement) {
          onlineStatusElement.textContent = '(Online)';
          onlineStatusElement.classList.add('text-green-500');
          onlineStatusElement.classList.remove('text-gray-500');
        }
      });

      // Listen for updates when a user goes offline
      socket.on('getOfflineUser', (data) => {
        const statusElement = document.getElementById(`status-${data.userId}`);
        const onlineStatusElement = document.getElementById(`onlineStatus-${data.userId}`);
        if (statusElement && onlineStatusElement) {
          onlineStatusElement.textContent = '(Offline)';
          onlineStatusElement.classList.add('text-gray-500');
          onlineStatusElement.classList.remove('text-green-500');
        }
      });

      // Function to handle opening a chat with a user
      function openChat(userId) {
        receiverId = userId;
        socket.emit('existsChat', { senderId, receiverId });

        // Remove previous listener to avoid duplication
        socket.off('loadChats');
        socket.on('loadChats', function (data) {
          const chats = data.chats;
          const chatMessages = document.getElementById('chatMessages');
          chatMessages.innerHTML = ''; // Clear previous messages

          chats.forEach(chat => {
            const messageElement = document.createElement('div');
            messageElement.classList.add(
              'message',
              chat.senderId === senderId ? 'sent' : 'received',
              chat.senderId === senderId ? 'bg-blue-100' : 'bg-gray-100',
              'p-2',
              'rounded-md',
              'mb-2',
              'relative'
            );
            messageElement.setAttribute('data-id', chat._id); // Add data-id for identification

            // Message content
            const messageContent = document.createElement('span');
            messageContent.textContent = chat.message;
            messageElement.appendChild(messageContent);

            // Add edit button for the sender's messages
            if (chat.senderId === senderId) {
              // Edit button
              const editButton = document.createElement('button');
              editButton.classList.add(
                'absolute',
                'top-1',
                'right-16', // Adjust positioning
                'text-blue-500',
                'hover:text-blue-700',
                'text-sm'
              );
              editButton.innerHTML = '<i class="fa fa-edit">Edit</i>';
              editButton.onclick = function () {
                openEditModal(chat._id, chat.message);
              };
              messageElement.appendChild(editButton);

              // Delete button
              const deleteButton = document.createElement('button');
              deleteButton.classList.add(
                'absolute',
                'top-1',
                'right-4',
                'text-red-500',
                'hover:text-red-700',
                'text-sm'
              );
              deleteButton.innerHTML = '<i class="fa fa-trash">Delete</i>';
              deleteButton.onclick = function () {
                deleteChat(chat._id);
              };
              messageElement.appendChild(deleteButton);
            }

            chatMessages.appendChild(messageElement);
          });



          chatMessages.scrollTop = chatMessages.scrollHeight; // Scroll to the latest message
        });
      }
























      // save chat of user , send the chat in backend
      // Send message to backend and display in chat box
      document.getElementById('sendMessage').addEventListener('click', (e) => {
        e.preventDefault(); // Prevent form submission
        const messageInput = document.getElementById('messageInput');
        const message = messageInput.value.trim(); // Get the message content
        console.log(message, receiverId)
        if (message && receiverId) {
          // Emit the message to the backend
          socket.emit('sendMessage', {
            senderId: senderId, // Current user (logged-in user)
            receiverId: receiverId, // Recipient user
            message: message, // Chat message content
          });

          // Display the message in the chat window (for the sender)
          const chatMessages = document.getElementById('chatMessages');
          const messageElement = document.createElement('div');
          messageElement.classList.add('message', 'sent', 'bg-blue-100', 'p-2', 'rounded-md', 'mb-2', 'self-end');
          messageElement.textContent = message;
          chatMessages.appendChild(messageElement);

          // Clear the input box
          messageInput.value = '';
          chatMessages.scrollTop = chatMessages.scrollHeight; // Scroll to the latest message
        }
      });

      // Listen for new messages from the backend
      socket.on('receiveMessage', (data) => {
        const { senderId: sender, message } = data;
        if (senderId == data.receiverId && receiverId == data.senderId) {
          // Display the message in the chat window (for the receiver)
          const chatMessages = document.getElementById('chatMessages');
          const messageElement = document.createElement('div');
          messageElement.classList.add('message', 'received', 'bg-gray-100', 'p-2', 'rounded-md', 'mb-2');
          messageElement.textContent = message;
          chatMessages.appendChild(messageElement);

          chatMessages.scrollTop = chatMessages.scrollHeight; // Scroll to the latest message
        }
      });


      // Open delete confirmation modal
      function openDeleteModal() {
        // Show the modal
        const modal = document.getElementById("default-modal");
        modal.classList.remove("hidden");
      }




      // Function to delete the chat
      function deleteChat(chatId) {
        fetch('http://localhost:4000/auth/delete-chat', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: chatId })
        })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              // Remove the deleted message locally
              const chatMessages = document.getElementById('chatMessages');
              const messageElement = chatMessages.querySelector(`[data-id="${chatId}"]`);
              if (messageElement) {
                messageElement.remove(); // Remove from the DOM
              }

              // Notify other users about the deleted message
              socket.emit("chatDeleted", chatId);
            }
          })
          .catch(error => {
            console.error('Error deleting chat:', error);
          });
      }



      // Listen for the 'chatMessageDeleted' broadcast event
      socket.on('chatMessageDeleted', function (id) {
        const chatMessages = document.getElementById('chatMessages');
        const messageElement = chatMessages.querySelector(`[data-id="${id}"]`);
        if (messageElement) {
          messageElement.remove(); // Remove the deleted message from the DOM
        }
      });




      // });






      // Model
      let currentEditingChatId = null;

      // Open the edit modal
      function openEditModal(chatId, message) {
        currentEditingChatId = chatId;
        const modal = document.getElementById('edit-modal');
        const input = document.getElementById('editMessageInput');
        input.value = message;
        modal.classList.remove('hidden');
      }

      // Close the edit modal
      function closeEditModal() {
        currentEditingChatId = null;
        const modal = document.getElementById('edit-modal');
        modal.classList.add('hidden');
      }

      // Save the edited message
      function saveEditedMessage() {
        const newMessage = document.getElementById('editMessageInput').value.trim();
        if (newMessage && currentEditingChatId) {
          fetch('http://localhost:4000/auth/update-chat', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: currentEditingChatId, message: newMessage })
          })
            .then(response => response.json())
            .then(data => {
              if (data.success) {
                // Emit the edited chat to the server
                console.log(data)
                socket.emit('chatUpdated', {
                  chatId: currentEditingChatId,
                  newMessage
                });

                // Update the chat UI immediately
                const chatElement = document.querySelector(`[data-id='${currentEditingChatId}']`);
                if (chatElement) {
                  const messageSpan = chatElement.querySelector('span');
                  if (messageSpan) messageSpan.textContent = newMessage;
                }

                closeEditModal();
              } else {
                console.error('Error editing chat:', data.message);
              }
            })
            .catch(error => console.error('Error:', error));
        }
      }

      // listen the event on the broadcast
      socket.on('chatMessageUpdated', function (data) {
        const chatElement = document.querySelector(`[data-id='${data.chatId}']`);
        console.log("This is live braodcast", data)
        if (chatElement) {
          const messageSpan = chatElement.querySelector('span');
          if (messageSpan) messageSpan.textContent = data.newMessage;
        }

        // closeEditModal();
      })
    </script>
</body>

</html>