<div class="group-page">
  <h1 class="text-2xl font-bold mb-4">Group Page</h1>

  <!-- Button to Open Modal -->
  <button class="px-4 py-2 bg-blue-500 text-white rounded" onclick="openModal()">
    Create New Group
  </button>


  <!-- Modal -->
  <div id="groupModal" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white p-6 rounded shadow-md w-96">
      <h2 class="text-lg font-semibold mb-4">Create New Group</h2>
      <form action="/auth/groups/create" method="POST" enctype="multipart/form-data" class="space-y-4">
        <div>
          <label for="name" class="block text-sm font-medium">Group Name</label>
          <input type="text" id="name" name="name" required class="w-full p-2 border rounded" />
        </div>
        <div>
          <label for="image" class="block text-sm font-medium">Group Image</label>
          <input type="file" id="image" name="image" required class="w-full p-2 border rounded" />
        </div>
        <div>
          <label for="limit" class="block text-sm font-medium">Member Limit</label>
          <input type="number" id="limit" name="limit" required class="w-full p-2 border rounded" />
        </div>
        <div class="flex justify-end">
          <button type="button" class="px-4 py-2 bg-gray-500 text-white rounded mr-2" onclick="closeModal()">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 bg-blue-500 text-white rounded">
            Create
          </button>
        </div>
      </form>
    </div>
  </div>

<!-- Members Modal -->
<div id="memberModal" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white p-6 rounded shadow-md w-1/2">
    <h2 class="text-lg font-semibold mb-4">Add Members to Group</h2>
    <form id="addMembersForm" class="space-y-4">
      <div class="relative overflow-x-auto">
        <table class="w-full text-sm text-left rtl:text-right text-gray-500">
          <thead class="text-xs text-gray-700 uppercase bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3">Name</th>
              <th scope="col" class="px-6 py-3">Add</th>
            </tr>
          </thead>
          <tbody id="membersList">
            <!-- Dynamically rendered members -->
          </tbody>
        </table>
      </div>
      <div class="flex justify-end">
        <button type="button" class="px-4 py-2 bg-gray-500 text-white rounded mr-2" onclick="closeMemberModal()">
          Cancel
        </button>
        <button type="submit" class="px-4 py-2 bg-blue-500 text-white rounded">
          Add Members
        </button>
      </div>
    </form>
  </div>
</div>



  <!-- Existing Groups -->
  <div class="group-list mt-6">
    <h2 class="text-lg font-semibold mb-4">Your Groups:</h2>
    <% if (groups && groups.length> 0) { %>
      <ul>
        <% groups.forEach((group)=> { %>
          <li class="p-4 bg-gray-100 mb-2 rounded flex items-center justify-between">
            <div class="p-4 bg-gray-100 mb-2 rounded flex items-center">
              <img src="<%= group.image %>" alt="<%= group.name %>" class="w-10 h-10 mr-4 rounded-full" />
              <span class="font-medium">
                <%= group.name %>
              </span>
            </div>
            <div onclick="openMembersModal()" class="text-blue-500 pr-4 cursor-pointer">
              Members
            </div>
          </li>
          <% }); %>
      </ul>
      <% } else { %>
        <p class="text-gray-500">No groups found. Create your first group!</p>
        <% } %>
  </div>
</div>

<script>
  async function fetchMembers() {
    try {
      const response = await fetch(' http://localhost:4000/auth/groups/members'); // Update the endpoint if necessary
      const data = await response.json();

      if (data.success) {
        const membersList = document.getElementById('membersList');
        membersList.innerHTML = data.users
          .map(
            (user) => `
          <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
            <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">
              ${user.name} (${user.email})
            </td>
            <td class="px-6 py-4">
              <input type="checkbox" name="members" value="${user._id}" />
            </td>
          </tr>
        `
          )
          .join('');
      } else {
        console.error('Failed to fetch members');
      }
    } catch (error) {
      console.error('Error fetching members:', error);
    }
  }

  function openMembersModal() {
    fetchMembers();
    document.getElementById('memberModal').classList.remove('hidden');
  }

  function closeMemberModal() {
    document.getElementById('memberModal').classList.add('hidden');
  }
</script>
